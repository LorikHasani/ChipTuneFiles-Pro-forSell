# ===========================================
# ChipTuneFiles Pro - Environment Configuration
# ===========================================

# Database
DATABASE_URL="mysql://root:your_password@localhost:3306/chiptunefiles"
DB_ROOT_PASSWORD=your_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/credits?success=true&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/credits?canceled=true

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ChipTuneFiles <noreply@yourdomain.com>"

# Admin (created on first setup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
